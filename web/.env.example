# Postgres connection string used by Payload's db-postgres adapter.
# Local dev default matches docker-compose.yml in this folder.
DATABASE_URL=postgres://onlypans:onlypans@localhost:5433/onlypans

# Long random string used to sign Payload's auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys).
# Checkout works without these (orders are recorded as pending, unpaid),
# but no payment will be collected until they're set.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Resend (https://resend.com/api-keys). Without this, emails are skipped and logged
# to the console instead — nothing breaks, notifications just won't be sent.
RESEND_API_KEY=
# Optional: "Name <verified@yourdomain.com>" once a domain is set up in Resend.
# Defaults to Resend's shared sandbox sender if left unset.
RESEND_FROM=
# Where the chef receives new-order/booking/catering/contact notifications.
# Comma-separate multiple addresses, e.g. chef@example.com,manager@example.com
CHEF_NOTIFICATION_EMAIL=
